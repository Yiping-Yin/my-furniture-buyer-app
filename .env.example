# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real values.

# Supabase dashboard -> Project Settings -> Data API
# These two are safe to expose in the browser. Row Level Security in the
# database is what actually protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
# Used ONLY on your own machine, by `npm run db:apply` and `npm run verify:db`.
# The deployed app never reads this. Do not add it to Vercel.
SUPABASE_DB_URL=
